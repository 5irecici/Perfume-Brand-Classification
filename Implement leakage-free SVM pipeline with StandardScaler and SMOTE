import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import train_test_split, cross_val_score
from imblearn.over_sampling import SMOTE
from imblearn.pipeline import Pipeline as ImbPipeline # 🟢 Sızdırmaz CV garantisi
from sklearn.svm import SVC # 🟢 Gradient Boosting yerine SVM
from sklearn.metrics import (accuracy_score, f1_score, precision_score,
                             recall_score, roc_auc_score, classification_report)
from google.colab import drive

# --- 1. ORTAM HAZIRLIĞI VE VERİ YÜKLEME ---
drive.mount('/content/drive')
path = '/content/drive/MyDrive/fra_cleaned.csv'

CUSTOM_PALETTE = ['#462506', '#9F6920', '#DAA755', '#E9C579', '#F1DEA8']
SEED = 42

try:
    data_raw = pd.read_csv(path, sep=';', encoding='latin-1')
    print("✅ 1. ADIM: Veri başarıyla yüklendi!")

    # --- 2. VERİ SETİNİ İLK 10 MARKA İLE SINIRLANDIRMA ---
    brand_counts = data_raw['Brand'].value_counts()
    top_10_list = brand_counts.head(10).index.tolist()
    data_filtered = data_raw[data_raw['Brand'].isin(top_10_list)].copy()

    # --- 3. ÖN İŞLEME: SAYISAL DÖNÜŞÜMLER ---
    if data_filtered['Rating Value'].dtype == 'object':
        data_filtered['Rating Value'] = data_filtered['Rating Value'].str.replace(',', '.').astype(float)

    # --- 4. KOPYALAMA VE EKSİK DEĞERLERİN DOLDURULMASI ---
    df = data_filtered.copy()

    for col in df.select_dtypes('object').columns:
        if not df[col].mode().empty: df[col] = df[col].fillna(df[col].mode()[0])
    for col in df.select_dtypes(include=[np.number]).columns:
        df[col] = df[col].fillna(df[col].median())

    # --- 5. HEDEF DEĞİŞKENİNİ ENCODE ETME ---
    le_brand = LabelEncoder()
    df['Brand_Encoded'] = le_brand.fit_transform(df['Brand'])

    # --- 6. GÜVENLİ KATEGORİK ENCODING ---
    exclude_cols = ['Brand', 'Brand_Encoded', 'url', 'Perfume', 'Description']
    feature_cols = [c for c in df.columns if c not in exclude_cols]

    for col in feature_cols:
        if df[col].dtype == 'object':
            le_temp = LabelEncoder()
            df[col] = le_temp.fit_transform(df[col].astype(str))

    X = df[feature_cols]
    y = df['Brand_Encoded']

    print(f'\n🚀 ÖZELLİK MATRİSLERİ OLUŞTURULDU (Boyut: {X.shape})')

    # --- 7. TRAIN / TEST AYRIMI ---
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=SEED, stratify=y
    )

    # --- 8. SIZDIRMAZ PIPELINE KURULUMU VE CV EĞİTİMİ --- 🟢
    print('\n🚀 DÜRÜST (SIZDIRMAZ) 5-FOLD CV EĞİTİMİ BAŞLIYOR...')

    # 🟢 DİKKAT: SVM mesafelere duyarlı olduğu için StandardScaler SADECE eğitim
    # katmanlarına uygulanmalıdır. Pipeline bunu otomatik yapar.
    pipeline = ImbPipeline([
        ('scaler', StandardScaler()),
        ('smote', SMOTE(random_state=SEED)),
        ('svc', SVC(kernel='rbf', probability=True, random_state=SEED))
    ])

    print('⏳ 5-Fold Çapraz Doğrulama hesaplanıyor...')
    cv_f1_scores = cross_val_score(pipeline, X_train, y_train, cv=5, scoring='f1_macro', n_jobs=-1)
    cv_acc_scores = cross_val_score(pipeline, X_train, y_train, cv=5, scoring='accuracy', n_jobs=-1)

    df_cv = pd.DataFrame({
        'Kat (Fold)' : [f'Fold {i+1}' for i in range(5)],
        'CV F1-Macro Skoru' : cv_f1_scores.round(4),
        'CV Accuracy Skoru' : cv_acc_scores.round(4)
    })
    summary = pd.DataFrame([{
        'Kat (Fold)' : 'Ortalama ± Std',
        'CV F1-Macro Skoru' : f'{cv_f1_scores.mean():.4f} ± {cv_f1_scores.std():.4f}',
        'CV Accuracy Skoru': f'{cv_acc_scores.mean():.4f} ± {cv_acc_scores.std():.4f}'
    }])
    df_cv_display = pd.concat([df_cv, summary], ignore_index=True)

    print('\n─── Sızdırmaz 5-Fold CV Sonuçları (SVM) ───')
    display(df_cv_display.style
            .set_caption('Dürüst 5-Fold Çapraz Doğrulama — SVM (Scaler + SMOTE Pipeline)')
            .applymap(lambda v: f'font-weight: bold; background-color: {CUSTOM_PALETTE[4]}; color: {CUSTOM_PALETTE[0]};'
                      if isinstance(v, str) and '±' in v else ''))

    # --- 9. NİHAİ MODEL EĞİTİMİ VE TEST SETİ DEĞERLENDİRMESİ ---
    print('\n🚀 NİHAİ MODEL EĞİTİLİYOR VE TEST EDİLİYOR...')

    # Pipeline nesnesini fit ettiğimizde, tüm X_train üzerinden sırasıyla:
    # 1. Ölçekleme öğrenilir, 2. SMOTE uygulanır, 3. SVM eğitilir.
    pipeline.fit(X_train, y_train)

    y_pred_final = pipeline.predict(X_test)
    y_prob_final = pipeline.predict_proba(X_test)

    test_metrics = {
        'Accuracy (Doğruluk)'    : accuracy_score(y_test, y_pred_final),
        'F1-Score (Macro)'       : f1_score(y_test, y_pred_final, average='macro'),
        'Precision (Kesinlik)'   : precision_score(y_test, y_pred_final, average='macro', zero_division=0),
        'Recall (Duyarlılık)'    : recall_score(y_test, y_pred_final, average='macro'),
        'AUC-ROC (Macro OVR)'    : roc_auc_score(y_test, y_prob_final, multi_class='ovr')
    }

    df_test = pd.DataFrame([{'Metrik' : k, 'Değer'  : round(v, 4)} for k, v in test_metrics.items()])

    print('\n─── Test Seti Sonuçları (SVM) ───')
    display(df_test.style
            .set_properties(**{'background-color': CUSTOM_PALETTE[3], 'color': CUSTOM_PALETTE[0], 'font-weight': 'bold'})
            .set_caption('Test Seti Performans Metrikleri'))

    # --- 10. CV vs TEST KARŞILAŞTIRMA TABLOSU (OVERFITTING KONTROLÜ) ---
    df_compare_cv = pd.DataFrame({
        'Metrik'          : ['F1-Score (Macro)'],
        'Dürüst CV Skoru' : [round(cv_f1_scores.mean(), 4)],
        'Test Skoru'      : [round(test_metrics['F1-Score (Macro)'], 4)],
        'Fark (Sapma)'    : [round(abs(cv_f1_scores.mean() - test_metrics['F1-Score (Macro)']), 4)]
    })

    print('\n─── CV Skoru vs Test Skoru Karşılaştırması ───')
    def style_compare(val, is_score=True):
        if is_score: return f'background-color: {CUSTOM_PALETTE[2]}; color: {CUSTOM_PALETTE[0]}; font-weight:bold;'
        else: return f'background-color: {CUSTOM_PALETTE[1]}; color: #fff; font-weight:bold;'

    display(df_compare_cv.style
            .applymap(lambda v: style_compare(v, True), subset=['Dürüst CV Skoru', 'Test Skoru'])
            .applymap(lambda v: style_compare(v, False), subset=['Fark (Sapma)'])
            .set_caption('SVM Modeli — Overfitting Kontrolü'))

    diff = df_compare_cv['Fark (Sapma)'].iloc[0]
    if diff < 0.05:
        print(f'\n✅ HARİKA! Dürüst CV ve Test skoru birbirine çok yakın (Fark: {diff:.4f}). SVM başarıyla genelleme yapmıştır.')
    else:
        print(f'\n⚠️ Test ve CV skoru arasındaki fark belirgin (Fark: {diff:.4f}). Modelin esnekliğini (C ve gamma) ayarlamak için hiperparametre optimizasyonu gerekebilir.')

except FileNotFoundError:
    print("❌ Hata: Dosya belirtilen yolda bulunamadı. Lütfen yolu kontrol edin.")
except Exception as e:
    print(f"❌ Bir hata oluştu: {e}")
