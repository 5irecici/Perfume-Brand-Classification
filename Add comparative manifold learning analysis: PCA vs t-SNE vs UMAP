import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import train_test_split
from imblearn.over_sampling import SMOTE
from sklearn.decomposition import PCA
from sklearn.manifold import TSNE
from google.colab import drive
import umap

# --- 1. ORTAM HAZIRLIĞI VE VERİ YÜKLEME ---
drive.mount('/content/drive')
path = '/content/drive/MyDrive/fra_cleaned.csv'

# RENK PALETİ (10 Marka İçin)
PALETTE = ['#2E8B57', '#3CB371', '#20B2AA', '#4682B4', '#6A5ACD',
           '#7B68EE', '#483D8B', '#5F9EA0', '#87CEEB', '#B0C4DE']
SEED = 42

try:
    # Veriyi yükleme
    data_raw = pd.read_csv(path, sep=';', encoding='latin-1')
    print("✅ 1. ADIM: Veri başarıyla yüklendi!")

    # --- 2. VERİ SETİNİ İLK 10 MARKA İLE SINIRLANDIRMA ---
    brand_counts = data_raw['Brand'].value_counts()
    top_10_list = brand_counts.head(10).index.tolist()
    data_filtered = data_raw[data_raw['Brand'].isin(top_10_list)].copy()

    print(f"✅ 2. ADIM: Veri seti ilk 10 markaya filtrelendi. Satır Sayısı: {len(data_filtered)}")

    # --- 3. ÖN İŞLEME: SAYISAL DÖNÜŞÜMLER ---
    if data_filtered['Rating Value'].dtype == 'object':
        data_filtered['Rating Value'] = data_filtered['Rating Value'].str.replace(',', '.').astype(float)

    # --- 4. KOPYALAMA VE EKSİK DEĞERLERİN DOLDURULMASI ---
    df = data_filtered.copy()
    cat_cols = df.select_dtypes('object').columns.tolist()
    for col in cat_cols:
        if not df[col].mode().empty:
            df[col] = df[col].fillna(df[col].mode()[0])

    num_cols = df.select_dtypes(include=[np.number]).columns
    for col in num_cols:
        df[col] = df[col].fillna(df[col].median())

    # --- 5. HEDEF DEĞİŞKENİNİ ENCODE ETME ---
    le_brand = LabelEncoder()
    df['Brand_Encoded'] = le_brand.fit_transform(df['Brand'])
    brand_names = le_brand.classes_

    # --- 6. KATEGORİK ÖZELLİKLERİ ENCODE ETME ---
    exclude_cols = ['Brand', 'Brand_Encoded', 'url', 'Perfume', 'Description']
    feature_cols = [c for c in df.columns if c not in exclude_cols]

    le_features = LabelEncoder()
    for col in feature_cols:
        if df[col].dtype == 'object':
            df[col] = le_features.fit_transform(df[col].astype(str))

    X = df[feature_cols]
    y = df['Brand_Encoded']

    print(f'\n🚀 ÖZELLİK MATRİSLERİ OLUŞTURULDU (Boyut: {X.shape})')

    # --- 7. TRAIN / TEST AYRIMI ---
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=SEED, stratify=y
    )

    # --- 8. STANDARDIZASYON ---
    scaler = StandardScaler()
    X_train_sc = scaler.fit_transform(X_train)
    X_test_sc  = scaler.transform(X_test)

    # --- 9. SMOTE UYGULAMASI ---
    smote = SMOTE(random_state=SEED)
    X_train_sm, y_train_sm = smote.fit_resample(X_train_sc, y_train)
    print(f"📌 SMOTE Sonrası Eğitim Seti Boyutu: {X_train_sm.shape}")

    # =========================================================================
    # 10. UMAP GÖRSELLEŞTİRME VE HİPERPARAMETRE ANALİZİ
    # =========================================================================
    print('\n🚀 UMAP HİPERPARAMETRE ANALİZİ BAŞLIYOR (Boyutlar 2\'ye indirgeniyor)...')

    # Görselleştirme için orijinal ve ölçeklenmiş veriyi (X_train_sc) kullanıyoruz (SMOTE YOK)
    X_viz = X_train_sc
    y_viz = y_train.values

    # --- 10.A UMAP: n_neighbors ve min_dist Çapraz Etkisi (2x2 Panel) ---
    print('⏳ 1. Aşama: n_neighbors ve min_dist çapraz etkisi hesaplanıyor...')
    configs = [
        {'n_neighbors': 5,  'min_dist': 0.1,  'label': 'n_neighbors=5,  min_dist=0.1'},
        {'n_neighbors': 15, 'min_dist': 0.1,  'label': 'n_neighbors=15, min_dist=0.1'},
        {'n_neighbors': 15, 'min_dist': 0.5,  'label': 'n_neighbors=15, min_dist=0.5'},
        {'n_neighbors': 50, 'min_dist': 0.1,  'label': 'n_neighbors=50, min_dist=0.1'},
    ]

    fig, axes = plt.subplots(2, 2, figsize=(16, 12))
    axes = axes.flatten()
    fig.suptitle('UMAP: n_neighbors ve min_dist Parametrelerinin Çapraz Etkisi (10 Marka)', fontsize=14, fontweight='bold')

    for ax, cfg in zip(axes, configs):
        reducer = umap.UMAP(n_components=2, n_neighbors=cfg['n_neighbors'],
                            min_dist=cfg['min_dist'], metric='euclidean', random_state=SEED)
        emb = reducer.fit_transform(X_viz)

        for cls_idx, brand in enumerate(brand_names):
            mask = (y_viz == cls_idx)
            ax.scatter(emb[mask, 0], emb[mask, 1], c=PALETTE[cls_idx], label=brand,
                       alpha=0.7, s=20, edgecolors='none')

        ax.set_title(cfg['label'], fontweight='bold', fontsize=11)
        ax.set_xlabel('UMAP Bileşeni 1'); ax.set_ylabel('UMAP Bileşeni 2')
        if cfg == configs[0]:
            ax.legend(title='Markalar', fontsize=8, loc='best', bbox_to_anchor=(1, 1))
        ax.grid(alpha=0.3, linestyle='--')

    plt.tight_layout(rect=[0, 0.03, 1, 0.95])
    plt.show()

    # --- 10.B UMAP: Sabit n_neighbors ile min_dist İzolasyonu (1x3 Panel) ---
    print('\n⏳ 2. Aşama: Sabit n_neighbors (15) ile min_dist değişimi hesaplanıyor...')
    min_dist_values = [0.0, 0.1, 0.5]
    fixed_n_neighbors = 15

    fig2, axes2 = plt.subplots(1, 3, figsize=(20, 6))
    fig2.suptitle(f'UMAP İzolasyonu: min_dist Değişimi (n_neighbors={fixed_n_neighbors} Sabit)', fontsize=14, fontweight='bold', y=1.05)

    for i, min_dist in enumerate(min_dist_values):
        reducer2 = umap.UMAP(n_neighbors=fixed_n_neighbors, min_dist=min_dist, random_state=SEED)
        X_umap2 = reducer2.fit_transform(X_viz)

        umap_df = pd.DataFrame(data=X_umap2, columns=['UMAP 1', 'UMAP 2'])
        umap_df['Marka'] = np.array(brand_names)[y_viz]

        sns.scatterplot(
            x='UMAP 1', y='UMAP 2', hue='Marka', palette=PALETTE, data=umap_df,
            legend='full', alpha=0.8, s=30, ax=axes2[i]
        )
        axes2[i].set_title(f'min_dist={min_dist}')
        axes2[i].grid(True, linestyle='--', alpha=0.4)

        if i == 2: axes2[i].legend(bbox_to_anchor=(1.05, 1), loc=2, borderaxespad=0.)
        else: axes2[i].get_legend().remove()

    plt.tight_layout()
    plt.show()

    # =========================================================================
    # 11. BÜYÜK FİNAL: PCA · t-SNE · UMAP YAN YANA KARŞILAŞTIRMASI
    # =========================================================================
    print('\n🚀 3. Aşama: PCA, t-SNE ve UMAP algoritmalarının genel kıyaslaması yapılıyor...')

    # A. PCA Hesaplaması (İlk 2 Bileşen)
    pca_2d  = PCA(n_components=2, random_state=SEED)
    emb_pca2 = pca_2d.fit_transform(X_viz)

    # B. t-SNE Hesaplaması (Perplexity=30)
    # 🟢 Not: Karşılaştırma yapabilmek için t-SNE'yi burada taze olarak hesaplıyoruz
    tsne_model = TSNE(n_components=2, perplexity=30, n_iter=800, learning_rate='auto', init='pca', random_state=SEED)
    emb_tsne_best = tsne_model.fit_transform(X_viz)

    # C. UMAP Hesaplaması (Optimum Parametreler: n=15, min_dist=0.1)
    reducer_best = umap.UMAP(n_components=2, n_neighbors=15, min_dist=0.1, random_state=SEED)
    emb_umap_best = reducer_best.fit_transform(X_viz)

    # Çizim Ekranı
    fig3, axes3 = plt.subplots(1, 3, figsize=(22, 6))
    fig3.suptitle('Boyut Düşürme Yöntemleri Karşılaştırması (10 Markanın 2D Manifold Uzayı)', fontsize=15, fontweight='bold', y=1.02)

    infos = [
        (emb_pca2,       f'PCA (2 Bileşen)\n(Korunan Varyans: {pca_2d.explained_variance_ratio_.sum()*100:.1f}%)'),
        (emb_tsne_best,  't-SNE\n(perplexity=30)'),
        (emb_umap_best,  'UMAP\n(n_neighbors=15, min_dist=0.1)'),
    ]

    for ax, (emb, title) in zip(axes3, infos):
        # 🟢 İkili sınıf hatası giderildi, 10 Marka dinamik olarak çizdiriliyor
        for cls_idx, brand in enumerate(brand_names):
            m = (y_viz == cls_idx)
            ax.scatter(emb[m, 0], emb[m, 1], c=PALETTE[cls_idx], label=brand,
                       alpha=0.7, s=25, edgecolors='white', linewidth=0.5)

        ax.set_title(title, fontweight='bold', fontsize=12)
        ax.grid(alpha=0.3, linestyle='--')

        # Lejantı sadece en sağdaki grafiğe (UMAP) ekliyoruz
        if title == infos[-1][1]:
            ax.legend(title='Markalar', fontsize=9, loc='center left', bbox_to_anchor=(1, 0.5))

    plt.tight_layout()
    plt.show()

    print('\n📌 Boyut Düşürme Analiz Özeti:')
    print('   - PCA: Doğrusal (Linear) bir yöntemdir. Gürültülü ve kategorik verilerde markaları birbirinden ayırmakta zorlanır, kümeler iç içe geçer (Yetersiz manifold).')
    print('   - t-SNE: Doğrusal olmayan (Non-linear) yerel yapılara çok duyarlıdır. Markaları küçük adacıklar halinde çok iyi koparır ancak büyük resimdeki (global) ilişkileri yok eder.')
    print('   - UMAP: Hem t-SNE kadar iyi yerel kümeleme yapar, hem de kümeler arasındaki uzaklığı (global topolojiyi) matematiksel olarak korur. Analizin şampiyonudur.')

except FileNotFoundError:
    print("❌ Hata: Dosya belirtilen yolda bulunamadı. Lütfen yolu kontrol edin.")
except Exception as e:
    print(f"❌ Bir hata oluştu: {e}")
