import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import train_test_split, cross_val_score, RandomizedSearchCV
from imblearn.over_sampling import SMOTE
from imblearn.pipeline import Pipeline as ImbPipeline
from sklearn.ensemble import RandomForestClassifier
from sklearn.feature_selection import SelectKBest, f_classif, RFE
from sklearn.metrics import (accuracy_score, f1_score, precision_score,
                             recall_score, roc_auc_score)
from google.colab import drive

# --- 1. ORTAM HAZIRLIĞI VE VERİ YÜKLEME ---
drive.mount('/content/drive')
path = '/content/drive/MyDrive/fra_cleaned.csv'

CUSTOM_PALETTE = ['#462506', '#9F6920', '#DAA755', '#E9C579', '#F1DEA8']
SEED = 42

try:
    data_raw = pd.read_csv(path, sep=';', encoding='latin-1')
    print("✅ 1. ADIM: Veri başarıyla yüklendi!")

    # --- 2. VERİ SETİNİ İLK 10 MARKA İLE SINIRLANDIRMA ---
    brand_counts = data_raw['Brand'].value_counts()
    top_10_list = brand_counts.head(10).index.tolist()
    data_filtered = data_raw[data_raw['Brand'].isin(top_10_list)].copy()

    # --- 3. ÖN İŞLEME: SAYISAL DÖNÜŞÜMLER ---
    if data_filtered['Rating Value'].dtype == 'object':
        data_filtered['Rating Value'] = data_filtered['Rating Value'].str.replace(',', '.').astype(float)

    # --- 4. KOPYALAMA VE EKSİK DEĞERLERİN DOLDURULMASI ---
    df = data_filtered.copy()
    for col in df.select_dtypes('object').columns:
        if not df[col].mode().empty: df[col] = df[col].fillna(df[col].mode()[0])
    for col in df.select_dtypes(include=[np.number]).columns:
        df[col] = df[col].fillna(df[col].median())

    # --- 5. HEDEF DEĞİŞKENİNİ ENCODE ETME ---
    le_brand = LabelEncoder()
    df['Brand_Encoded'] = le_brand.fit_transform(df['Brand'])

    # --- 6. KATEGORİK ÖZELLİKLERİ ENCODE ETME ---
    exclude_cols = ['Brand', 'Brand_Encoded', 'url', 'Perfume', 'Description']
    feature_cols = [c for c in df.columns if c not in exclude_cols]

    le_features = LabelEncoder()
    for col in feature_cols:
        if df[col].dtype == 'object':
            df[col] = le_features.fit_transform(df[col].astype(str))

    X = df[feature_cols]
    y = df['Brand_Encoded']

    # --- 7. TRAIN / TEST AYRIMI ---
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=SEED, stratify=y
    )

    # --- 8. STANDARDIZASYON ---
    scaler = StandardScaler()
    X_train_sc = scaler.fit_transform(X_train)
    X_test_sc  = scaler.transform(X_test)

    # --- 9. ÖZELLİK SEÇİMİ (VOTING) İÇİN GEÇİCİ SMOTE ---
    print('\n🚀 ÖZELLİK SEÇİMİ VE OYLAMA YAPILIYOR...')
    smote_temp = SMOTE(random_state=SEED)
    X_train_sm_temp, y_train_sm_temp = smote_temp.fit_resample(X_train_sc, y_train)

    selector_kb = SelectKBest(score_func=f_classif, k=10).fit(X_train_sm_temp, y_train_sm_temp)
    selected_kb = np.array(feature_cols)[selector_kb.get_support()].tolist()

    rf_feat = RandomForestClassifier(n_estimators=50, random_state=SEED, n_jobs=-1).fit(X_train_sm_temp, y_train_sm_temp)
    importances = pd.DataFrame({'Özellik': feature_cols, 'Önem': rf_feat.feature_importances_})
    selected_rf = importances.sort_values('Önem', ascending=False).head(10)['Özellik'].tolist()

    rfe = RFE(estimator=rf_feat, n_features_to_select=10, step=1).fit(X_train_sm_temp, y_train_sm_temp)
    selected_rfe = np.array(feature_cols)[rfe.support_].tolist()

    sets = {'SelectKBest': set(selected_kb), 'RF Önemi': set(selected_rf), 'RFE': set(selected_rfe)}
    comparison = pd.DataFrame({name: [('✅' if f in s else '❌') for f in feature_cols] for name, s in sets.items()}, index=feature_cols)
    comparison['Oy Sayısı'] = comparison.apply(lambda r: list(r.values).count('✅'), axis=1)

    selected_final = comparison[comparison['Oy Sayısı'] >= 2].index.tolist()
    print(f'📌 Seçilen Nihai Özellik Seti ({len(selected_final)} Adet): {selected_final}')

    # Veri setini seçilen özelliklere göre daraltma
    final_idx = [feature_cols.index(f) for f in selected_final]
    X_train_final_sc = X_train_sc[:, final_idx]
    X_test_final_sc  = X_test_sc[:, final_idx]

    # =========================================================================
    # 10. BASELINE MODEL (TÜM ÖZELLİKLER - VARSAYILAN RF)
    # =========================================================================
    print('\n🚀 BASELINE MODEL (Tüm Özellikler - Varsayılan RF) EĞİTİLİYOR...')
    pipeline_base = ImbPipeline([('smote', SMOTE(random_state=SEED)), ('rf', RandomForestClassifier(random_state=SEED, n_jobs=-1))])
    cv_scores_base = cross_val_score(pipeline_base, X_train_sc, y_train, cv=5, scoring='f1_macro')

    X_train_sm_base, y_train_sm_base = smote_temp.fit_resample(X_train_sc, y_train)
    rf_baseline = RandomForestClassifier(random_state=SEED, n_jobs=-1).fit(X_train_sm_base, y_train_sm_base)

    test_metrics_base = {
        'F1-Macro': f1_score(y_test, rf_baseline.predict(X_test_sc), average='macro'),
        'AUC-ROC': roc_auc_score(y_test, rf_baseline.predict_proba(X_test_sc), multi_class='ovr')
    }

    # =========================================================================
    # 11. FİLTRELENMİŞ MODEL (SEÇİLEN ÖZELLİKLER - VARSAYILAN RF)
    # =========================================================================
    print('\n🚀 FİLTRELİ MODEL (Seçilen Özellikler - Varsayılan RF) EĞİTİLİYOR...')
    pipeline_final = ImbPipeline([('smote', SMOTE(random_state=SEED)), ('rf', RandomForestClassifier(random_state=SEED, n_jobs=-1))])
    cv_scores_final = cross_val_score(pipeline_final, X_train_final_sc, y_train, cv=5, scoring='f1_macro')

    X_train_sm_final, y_train_sm_final = smote_temp.fit_resample(X_train_final_sc, y_train)
    rf_final = RandomForestClassifier(random_state=SEED, n_jobs=-1).fit(X_train_sm_final, y_train_sm_final)

    test_metrics_final = {
        'F1-Macro': f1_score(y_test, rf_final.predict(X_test_final_sc), average='macro'),
        'AUC-ROC': roc_auc_score(y_test, rf_final.predict_proba(X_test_final_sc), multi_class='ovr')
    }

    # =========================================================================
    # 12. HİPERPARAMETRE OPTİMİZASYONU (SEÇİLEN ÖZELLİKLER ÜZERİNDE)
    # =========================================================================
    print('\n🚀 HİPERPARAMETRE OPTİMİZASYONU (RandomizedSearchCV) BAŞLIYOR...')
    print('⏳ Parametreler aranıyor (Birkaç dakika sürebilir)...')

    # Sızdırmaz CV Pipeline'ı Optimizatör için kuruyoruz
    pipeline_opt = ImbPipeline([
        ('smote', SMOTE(random_state=SEED)),
        ('rf', RandomForestClassifier(random_state=SEED, n_jobs=-1))
    ])

    # Parametre Uzayı (rf__ öneki, pipeline içindeki isme atıfta bulunur)
    param_grid = {
        'rf__n_estimators': [50, 100, 200, 300],          # Ormandaki ağaç sayısı
        'rf__max_depth': [5, 10, 15, 20],                 # Ağaçların maksimum derinliği (Overfitting Törpüsü)
        'rf__min_samples_split': [2, 5, 10],              # Dalı bölmek için gereken min örnek
        'rf__min_samples_leaf': [1, 2, 4],                # Yaprakta kalması gereken min örnek
        'rf__max_features': ['sqrt', 'log2']              # Özellik seçimi alt kümesi
    }

    random_search = RandomizedSearchCV(
        estimator=pipeline_opt,
        param_distributions=param_grid,
        n_iter=20,          # Hız için 20 farklı kombinasyon dene
        scoring='f1_macro',
        cv=5,               # Sızdırmaz 5-Fold
        verbose=1,
        random_state=SEED,
        n_jobs=-1
    )

    random_search.fit(X_train_final_sc, y_train)

    print(f"\n🏆 EN İYİ PARAMETRELER BULUNDU:")
    best_params_clean = {k.replace('rf__', ''): v for k, v in random_search.best_params_.items()}
    for k, v in best_params_clean.items():
        print(f"   - {k}: {v}")

    # En İyi Modelin Test Setinde Sınanması
    best_rf_model = random_search.best_estimator_
    y_pred_opt = best_rf_model.predict(X_test_final_sc)
    y_prob_opt = best_rf_model.predict_proba(X_test_final_sc)

    test_metrics_opt = {
        'F1-Macro': f1_score(y_test, y_pred_opt, average='macro'),
        'AUC-ROC': roc_auc_score(y_test, y_prob_opt, multi_class='ovr')
    }

    # =========================================================================
    # 13. BÜYÜK FİNAL: GENEL KARŞILAŞTIRMA VE TEKNİK ANALİZ
    # =========================================================================
    print('\n─── 🏆 EVRİM TABLOSU: Baseline ➔ Filtreli ➔ Optimize Model ───')

    df_genel = pd.DataFrame({
        'Model Evrimi'   : ['1. Ham Baseline (Tüm Özellikler)',
                            f'2. Filtreli (Seçilen {len(selected_final)} Özellik)',
                            '3. HPO Optimize (Filtreli + Parametreler)'],
        'Dürüst CV F1'   : [round(cv_scores_base.mean(), 4),
                            round(cv_scores_final.mean(), 4),
                            round(random_search.best_score_, 4)],
        'Test F1 (Macro)': [round(test_metrics_base['F1-Macro'], 4),
                            round(test_metrics_final['F1-Macro'], 4),
                            round(test_metrics_opt['F1-Macro'], 4)],
        'Sapma (CV-Test)': [round(abs(cv_scores_base.mean() - test_metrics_base['F1-Macro']), 4),
                            round(abs(cv_scores_final.mean() - test_metrics_final['F1-Macro']), 4),
                            round(abs(random_search.best_score_ - test_metrics_opt['F1-Macro']), 4)],
        'AUC-ROC (OVR)'  : [round(test_metrics_base['AUC-ROC'], 4),
                            round(test_metrics_final['AUC-ROC'], 4),
                            round(test_metrics_opt['AUC-ROC'], 4)],
    })

    display(df_genel.style
            .highlight_max(subset=['Dürüst CV F1', 'Test F1 (Macro)', 'AUC-ROC (OVR)'], color=CUSTOM_PALETTE[2])
            .highlight_min(subset=['Sapma (CV-Test)'], color=CUSTOM_PALETTE[2])
            .set_properties(**{'border': f'1px solid {CUSTOM_PALETTE[0]}', 'text-align': 'center'})
            .set_caption('Modelin Optimizasyon Süreci - Genel Performans Karşılaştırması')
            .set_table_styles([{'selector': 'th', 'props': [('background-color', CUSTOM_PALETTE[0]), ('color', 'white')]}]))

    diff_opt = df_genel['Sapma (CV-Test)'].iloc[2]
    print(f'\n📌 Optimize Model Sapması: {diff_opt:.4f}')

    if diff_opt < 0.04:
        print('   ✅ Başarılı! Hiperparametre optimizasyonu, özellikleri seçilmiş modelin son ezberleme kalıntılarını da temizledi. Model harika genelliyor.')
    else:
        print('   ⚠️ Optimizasyona rağmen fark varsa, sorun veri setinin yapısal sınırlamalarından (yetersiz veri hacmi) kaynaklanıyor olabilir.')

except FileNotFoundError:
    print("❌ Hata: Dosya belirtilen yolda bulunamadı.")
except Exception as e:
    print(f"❌ Bir hata oluştu: {e}")
