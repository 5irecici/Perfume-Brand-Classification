import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import train_test_split, cross_val_score, RandomizedSearchCV # 🟢 RandomizedSearchCV Eklendi
from imblearn.over_sampling import SMOTE
from imblearn.pipeline import Pipeline as ImbPipeline
from sklearn.ensemble import GradientBoostingClassifier
from sklearn.metrics import (accuracy_score, f1_score, precision_score,
                             recall_score, roc_auc_score, classification_report)
from google.colab import drive

# --- 1. ORTAM HAZIRLIĞI VE VERİ YÜKLEME ---
drive.mount('/content/drive')
path = '/content/drive/MyDrive/fra_cleaned.csv'

# KULLANICI ÖZEL RENK PALETİ
CUSTOM_PALETTE = ['#462506', '#9F6920', '#DAA755', '#E9C579', '#F1DEA8']

try:
    # Veriyi yükleme
    data_raw = pd.read_csv(path, sep=';', encoding='latin-1')
    print("✅ 1. ADIM: Veri başarıyla yüklendi!")

    # --- 2. VERİ SETİNİ İLK 10 MARKA İLE SINIRLANDIRMA ---
    brand_counts = data_raw['Brand'].value_counts()
    top_10_list = brand_counts.head(10).index.tolist()
    data_filtered = data_raw[data_raw['Brand'].isin(top_10_list)].copy()

    # --- 3. ÖN İŞLEME: SAYISAL DÖNÜŞÜMLER ---
    if data_filtered['Rating Value'].dtype == 'object':
        data_filtered['Rating Value'] = data_filtered['Rating Value'].str.replace(',', '.').astype(float)

    # --- 4. KOPYALAMA VE EKSİK DEĞERLERİN DOLDURULMASI ---
    df = data_filtered.copy()

    cat_cols = df.select_dtypes('object').columns.tolist()
    for col in cat_cols:
        if not df[col].mode().empty:
            df[col] = df[col].fillna(df[col].mode()[0])

    num_cols = df.select_dtypes(include=[np.number]).columns
    for col in num_cols:
        df[col] = df[col].fillna(df[col].median())

    # --- 5. HEDEF DEĞİŞKENİNİ ENCODE ETME ---
    le_brand = LabelEncoder()
    df['Brand_Encoded'] = le_brand.fit_transform(df['Brand'])

    # --- 6. KATEGORİK ÖZELLİKLERİ ENCODE ETME ---
    exclude_cols = ['Brand', 'Brand_Encoded', 'url', 'Perfume', 'Description']
    feature_cols = [c for c in df.columns if c not in exclude_cols]

    le_features = LabelEncoder()
    for col in feature_cols:
        if df[col].dtype == 'object':
            df[col] = le_features.fit_transform(df[col].astype(str))

    X = df[feature_cols]
    y = df['Brand_Encoded']

    print(f'\n🚀 ÖZELLİK MATRİSLERİ OLUŞTURULDU (Boyut: {X.shape})')

    # --- 7. TRAIN / TEST AYRIMI ---
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=42, stratify=y
    )

    # --- 8. STANDARDIZASYON ---
    scaler = StandardScaler()
    X_train_sc = scaler.fit_transform(X_train)
    X_test_sc  = scaler.transform(X_test)
    print('🚀 ÖLÇEKLEME TAMAMLANDI')

    # --- 9. HİPERPARAMETRE OPTİMİZASYONU (SIZDIRMAZ PIPELINE İLE) ---
    print('\n🚀 HİPERPARAMETRE OPTİMİZASYONU BAŞLIYOR (Bu işlem birkaç dakika sürebilir)...')

    # 🟢 Pipeline Tanımlaması: SMOTE ve Model tek zincirde.
    pipeline = ImbPipeline([
        ('smote', SMOTE(random_state=42)),
        ('gb', GradientBoostingClassifier(random_state=42))
    ])

    # 🟢 Arama Uzayı (Parametre Izgarası)
    # Parametrelerin başına "gb__" koyuyoruz çünkü Pipeline içindeki modelin adı 'gb'
    param_grid = {
        'gb__n_estimators': [50, 100, 200],          # Ağaç sayısı
        'gb__learning_rate': [0.01, 0.05, 0.1, 0.2], # Öğrenme hızı
        'gb__max_depth': [3, 5, 7],                  # Maksimum derinlik (Aşırı öğrenmeyi törpüler)
        'gb__min_samples_split': [2, 5, 10],         # Dalı bölmek için gereken minimum örnek
        'gb__subsample': [0.8, 0.9, 1.0]             # Her ağaç için rastgele örneklem oranı
    }

    # RandomizedSearchCV Kurulumu (Sızdırmaz CV ile 15 rastgele kombinasyon dener)
    random_search = RandomizedSearchCV(
        estimator=pipeline,
        param_distributions=param_grid,
        n_iter=15,
        scoring='f1_macro',
        cv=5,               # Sızdırmaz 5-Fold
        verbose=1,
        random_state=42,
        n_jobs=-1           # Tüm işlemci gücünü kullan
    )

    # Sadece Eğitim verisi verilir, Pipeline SMOTE'u içeride halleder
    random_search.fit(X_train_sc, y_train)

    print(f"\n🏆 EN İYİ PARAMETRELER BULUNDU:")
    # Çıktıyı temizlemek için "gb__" önekini kaldırıyoruz
    best_params_clean = {k.replace('gb__', ''): v for k, v in random_search.best_params_.items()}
    for k, v in best_params_clean.items():
        print(f"   - {k}: {v}")

    # --- 10. OPTİMİZE EDİLMİŞ MODELİN TEST SETİ DEĞERLENDİRMESİ ---
    print('\n🚀 NİHAİ (OPTİMİZE) MODEL TEST SETİNDE SINANIYOR...')

    # best_estimator_ arka planda zaten tüm eğitim verisini (X_train_sc)
    # SMOTE ile çoğaltıp en iyi parametrelerle eğitmiş halini tutar. Direkt tahmin alabiliriz!
    best_pipeline = random_search.best_estimator_

    y_pred_opt = best_pipeline.predict(X_test_sc)
    y_prob_opt = best_pipeline.predict_proba(X_test_sc)

    # Sınıflandırma Metrikleri
    test_metrics = {
        'Accuracy (Doğruluk)'    : accuracy_score(y_test, y_pred_opt),
        'F1-Score (Macro)'       : f1_score(y_test, y_pred_opt, average='macro'),
        'Precision (Kesinlik)'   : precision_score(y_test, y_pred_opt, average='macro', zero_division=0),
        'Recall (Duyarlılık)'    : recall_score(y_test, y_pred_opt, average='macro'),
        'AUC-ROC (Macro OVR)'    : roc_auc_score(y_test, y_prob_opt, multi_class='ovr')
    }

    df_test = pd.DataFrame([{
        'Metrik' : k,
        'Değer'  : round(v, 4)
    } for k, v in test_metrics.items()])

    print('\n─── Test Seti Sonuçları (Optimize Model) ───')
    display(df_test.style
            .set_properties(**{'background-color': CUSTOM_PALETTE[3], 'color': CUSTOM_PALETTE[0], 'font-weight': 'bold'})
            .set_caption('Optimize Test Seti Performans Metrikleri'))

    # --- 11. CV vs TEST KARŞILAŞTIRMA TABLOSU (OVERFITTING KONTROLÜ) ---
    df_compare_cv = pd.DataFrame({
        'Metrik'          : ['F1-Score (Macro)'],
        'Optimize CV Skoru' : [round(random_search.best_score_, 4)],
        'Test Skoru'      : [round(test_metrics['F1-Score (Macro)'], 4)],
        'Fark (Sapma)'    : [round(abs(random_search.best_score_ - test_metrics['F1-Score (Macro)']), 4)]
    })

    print('\n─── CV Skoru vs Test Skoru Karşılaştırması ───')

    def style_compare(val, is_score=True):
        if is_score:
            return f'background-color: {CUSTOM_PALETTE[2]}; color: {CUSTOM_PALETTE[0]}; font-weight:bold;'
        else:
            return f'background-color: {CUSTOM_PALETTE[1]}; color: #fff; font-weight:bold;'

    styled_compare = (df_compare_cv.style
                      .applymap(lambda v: style_compare(v, True), subset=['Optimize CV Skoru', 'Test Skoru'])
                      .applymap(lambda v: style_compare(v, False), subset=['Fark (Sapma)'])
                      .set_caption('Optimize Model — Overfitting Kontrolü'))
    display(styled_compare)

    # Overfitting (Aşırı Uydurma) Sinyali
    diff = df_compare_cv['Fark (Sapma)'].iloc[0]

    if diff < 0.05:
        print(f'\n✅ HARİKA! Optimizasyon modeli başarıyla terbiye etti (Fark: {diff:.4f}). Sızıntı engellendi ve ezber (overfitting) ortadan kalktı.')
    else:
        print(f'\n⚠️ Sapma (Fark: {diff:.4f}) hala yüksek. Ancak hiperparametre optimizasyonu sayesinde eski varsayılan modele göre makasın daralmış olması beklenir.')

except FileNotFoundError:
    print("❌ Hata: Dosya belirtilen yolda bulunamadı. Lütfen yolu kontrol edin.")
except Exception as e:
    print(f"❌ Bir hata oluştu: {e}")
