import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import train_test_split, cross_val_score, RandomizedSearchCV # 🟢 RandomizedSearchCV Eklendi
from imblearn.over_sampling import SMOTE
from imblearn.pipeline import Pipeline as ImbPipeline
from sklearn.ensemble import GradientBoostingClassifier
from sklearn.feature_selection import SelectKBest, f_classif, RFE
from sklearn.decomposition import PCA
from sklearn.metrics import (accuracy_score, f1_score, precision_score,
                             recall_score, roc_auc_score, classification_report)
from google.colab import drive

# --- 1. ORTAM HAZIRLIĞI VE VERİ YÜKLEME ---
drive.mount('/content/drive')
path = '/content/drive/MyDrive/fra_cleaned.csv'

CUSTOM_PALETTE = ['#462506', '#9F6920', '#DAA755', '#E9C579', '#F1DEA8']
SEED = 42

try:
    data_raw = pd.read_csv(path, sep=';', encoding='latin-1')
    print("✅ 1. ADIM: Veri başarıyla yüklendi!")

    # --- 2. VERİ SETİNİ İLK 10 MARKA İLE SINIRLANDIRMA ---
    brand_counts = data_raw['Brand'].value_counts()
    top_10_list = brand_counts.head(10).index.tolist()
    data_filtered = data_raw[data_raw['Brand'].isin(top_10_list)].copy()

    # --- 3. ÖN İŞLEME: SAYISAL DÖNÜŞÜMLER ---
    if data_filtered['Rating Value'].dtype == 'object':
        data_filtered['Rating Value'] = data_filtered['Rating Value'].str.replace(',', '.').astype(float)

    # --- 4. KOPYALAMA VE EKSİK DEĞERLERİN DOLDURULMASI ---
    df = data_filtered.copy()
    for col in df.select_dtypes('object').columns:
        if not df[col].mode().empty: df[col] = df[col].fillna(df[col].mode()[0])
    for col in df.select_dtypes(include=[np.number]).columns:
        df[col] = df[col].fillna(df[col].median())

    # --- 5. HEDEF DEĞİŞKENİNİ ENCODE ETME ---
    le_brand = LabelEncoder()
    df['Brand_Encoded'] = le_brand.fit_transform(df['Brand'])

    # --- 6. KATEGORİK ÖZELLİKLERİ ENCODE ETME ---
    exclude_cols = ['Brand', 'Brand_Encoded', 'url', 'Perfume', 'Description']
    feature_cols = [c for c in df.columns if c not in exclude_cols]

    le_features = LabelEncoder()
    for col in feature_cols:
        if df[col].dtype == 'object':
            df[col] = le_features.fit_transform(df[col].astype(str))

    X = df[feature_cols]
    y = df['Brand_Encoded']

    # --- 7. TRAIN / TEST AYRIMI ---
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=SEED, stratify=y
    )

    # --- 8. STANDARDIZASYON ---
    scaler = StandardScaler()
    X_train_sc = scaler.fit_transform(X_train)
    X_test_sc  = scaler.transform(X_test)

    # --- 9. GEÇİCİ SMOTE (Varyans Hesabı İçin) ---
    print('\n🚀 ÖN İŞLEME TAMAM. Geçici hesaplamalar yapılıyor...')
    smote_temp = SMOTE(random_state=SEED)
    X_train_sm_temp, y_train_sm_temp = smote_temp.fit_resample(X_train_sc, y_train)

    # =========================================================================
    # A. ÖZELLİK SEÇİMİ (VOTING/OYLAMA) HAZIRLIĞI
    # =========================================================================
    print('\n🚀 YÖNTEM A: ÖZELLİK SEÇİMİ (VOTING) HAZIRLANIYOR...')
    selector_kb = SelectKBest(score_func=f_classif, k=10).fit(X_train_sm_temp, y_train_sm_temp)
    selected_kb = np.array(feature_cols)[selector_kb.get_support()].tolist()

    gb_feat = GradientBoostingClassifier(n_estimators=50, random_state=SEED).fit(X_train_sm_temp, y_train_sm_temp)
    selected_gb = pd.DataFrame({'Özellik': feature_cols, 'Önem': gb_feat.feature_importances_}).sort_values('Önem', ascending=False).head(10)['Özellik'].tolist()

    rfe = RFE(estimator=gb_feat, n_features_to_select=10, step=1).fit(X_train_sm_temp, y_train_sm_temp)
    selected_rfe = np.array(feature_cols)[rfe.support_].tolist()

    sets = {'SelectKBest': set(selected_kb), 'GB Önemi': set(selected_gb), 'RFE': set(selected_rfe)}
    comparison = pd.DataFrame({name: [('✅' if f in s else '❌') for f in feature_cols] for name, s in sets.items()}, index=feature_cols)
    comparison['Oy Sayısı'] = comparison.apply(lambda r: list(r.values).count('✅'), axis=1)

    selected_final = comparison[comparison['Oy Sayısı'] >= 2].index.tolist()
    final_idx = [feature_cols.index(f) for f in selected_final]

    X_train_final_sc = X_train_sc[:, final_idx]
    X_test_final_sc  = X_test_sc[:, final_idx]

    # =========================================================================
    # B. PCA BİLEŞEN SAYISI BELİRLENİYOR
    # =========================================================================
    print('\n🚀 YÖNTEM B: PCA BİLEŞEN SAYISI BELİRLENİYOR...')
    pca_temp = PCA(random_state=SEED).fit(X_train_sm_temp)
    n90 = np.argmax(np.cumsum(pca_temp.explained_variance_ratio_) * 100 >= 90) + 1
    print(f'📌 %90 Varyans için gereken PCA Bileşeni: {n90}')

    # =========================================================================
    # C. BASELINE VE FİLTRELİ MODELLERİN EĞİTİMİ (Varsayılan GB)
    # =========================================================================
    print('\n🚀 BASELINE VE FİLTRELİ MODELLER (Varsayılan GB) EĞİTİLİYOR...')

    # Model 1: Baseline (Tüm Özellikler)
    pipeline_base = ImbPipeline([('smote', SMOTE(random_state=SEED)), ('gb', GradientBoostingClassifier(n_estimators=100, random_state=SEED))])
    cv_base = cross_val_score(pipeline_base, X_train_sc, y_train, cv=5, scoring='f1_macro')
    pipeline_base.fit(X_train_sc, y_train)
    test_f1_base = f1_score(y_test, pipeline_base.predict(X_test_sc), average='macro')
    auc_base = roc_auc_score(y_test, pipeline_base.predict_proba(X_test_sc), multi_class='ovr')

    # Model 2: Filtreli (Oylama)
    pipeline_final = ImbPipeline([('smote', SMOTE(random_state=SEED)), ('gb', GradientBoostingClassifier(n_estimators=100, random_state=SEED))])
    cv_final = cross_val_score(pipeline_final, X_train_final_sc, y_train, cv=5, scoring='f1_macro')
    pipeline_final.fit(X_train_final_sc, y_train)
    test_f1_final = f1_score(y_test, pipeline_final.predict(X_test_final_sc), average='macro')
    auc_final = roc_auc_score(y_test, pipeline_final.predict_proba(X_test_final_sc), multi_class='ovr')

    # Model 3: PCA (Varsayılan GB)
    pipeline_pca = ImbPipeline([
        ('smote', SMOTE(random_state=SEED)),
        ('pca', PCA(n_components=n90, random_state=SEED)),
        ('gb', GradientBoostingClassifier(n_estimators=100, random_state=SEED))
    ])
    cv_scores_pca = cross_val_score(pipeline_pca, X_train_sc, y_train, cv=5, scoring='f1_macro')
    pipeline_pca.fit(X_train_sc, y_train)
    test_f1_pca = f1_score(y_test, pipeline_pca.predict(X_test_sc), average='macro')
    auc_pca = roc_auc_score(y_test, pipeline_pca.predict_proba(X_test_sc), multi_class='ovr')

    # =========================================================================
    # D. HİPERPARAMETRE OPTİMİZASYONU (PCA ÜZERİNDE) 🟢
    # =========================================================================
    print(f'\n🚀 MODEL 4: HİPERPARAMETRE OPTİMİZASYONU BAŞLIYOR (PCA Bileşenleri İçin)...')
    print('⏳ Parametreler aranıyor (Birkaç dakika sürebilir)...')

    # 🟢 Optimizasyon Pipeline'ı: SMOTE -> PCA -> Gradient Boosting
    pipeline_opt_pca = ImbPipeline([
        ('smote', SMOTE(random_state=SEED)),
        ('pca', PCA(n_components=n90, random_state=SEED)),
        ('gb', GradientBoostingClassifier(random_state=SEED))
    ])

    # Parametre Uzayı ('gb__' öneki pipeline içindeki modele aittir)
    param_grid_pca = {
        'gb__n_estimators': [50, 100, 200, 300],
        'gb__learning_rate': [0.01, 0.05, 0.1, 0.2],
        'gb__max_depth': [3, 5, 7, 9],
        'gb__min_samples_split': [2, 5, 10],
        'gb__subsample': [0.8, 0.9, 1.0]
    }

    # 🟢 DİKKAT: Arama motoruna orijinal `X_train_sc` veriyoruz. PCA ve SMOTE içeride hesaplanacak.
    random_search_pca = RandomizedSearchCV(
        estimator=pipeline_opt_pca,
        param_distributions=param_grid_pca,
        n_iter=15,
        scoring='f1_macro',
        cv=5,               # Sızdırmaz CV
        verbose=1,
        random_state=SEED,
        n_jobs=-1
    )

    random_search_pca.fit(X_train_sc, y_train)

    print(f"\n🏆 PCA İÇİN EN İYİ PARAMETRELER BULUNDU:")
    best_params_pca_clean = {k.replace('gb__', ''): v for k, v in random_search_pca.best_params_.items()}
    for k, v in best_params_pca_clean.items():
        print(f"   - {k}: {v}")

    # Optimize Edilmiş PCA Modelinin Test Performansı
    best_pca_model = random_search_pca.best_estimator_
    y_pred_opt_pca = best_pca_model.predict(X_test_sc)
    y_prob_opt_pca = best_pca_model.predict_proba(X_test_sc)

    test_f1_opt_pca = f1_score(y_test, y_pred_opt_pca, average='macro')
    auc_opt_pca = roc_auc_score(y_test, y_prob_opt_pca, multi_class='ovr')

    # =========================================================================
    # E. BÜYÜK FİNAL: 4 YÖNTEM GENEL KARŞILAŞTIRMASI 🟢
    # =========================================================================
    print('\n─── 🏆 Boyut Düşürme ve Optimizasyon Stratejileri Karşılaştırma Matrisi ───')

    df_genel4 = pd.DataFrame({
        'Model Stratejisi': [
            f'1. Baseline: Ham Veri ({X_train_sc.shape[1]} Özellik)',
            f'2. Filtreli: Oylama ({len(selected_final)} Özellik)',
            f'3. PCA: Varsayılan GB ({n90} Bileşen)',
            f'4. PCA Optimize: HPO + PCA ({n90} Bileşen)'
        ],
        'Dürüst CV F1 (Macro)': [
            round(cv_base.mean(), 4),
            round(cv_final.mean(), 4),
            round(cv_scores_pca.mean(), 4),
            round(random_search_pca.best_score_, 4)
        ],
        'Test F1 (Macro)': [
            round(test_f1_base, 4),
            round(test_f1_final, 4),
            round(test_f1_pca, 4),
            round(test_f1_opt_pca, 4)
        ],
        'Sapma (Overfitting)': [
            round(abs(cv_base.mean() - test_f1_base), 4),
            round(abs(cv_final.mean() - test_f1_final), 4),
            round(abs(cv_scores_pca.mean() - test_f1_pca), 4),
            round(abs(random_search_pca.best_score_ - test_f1_opt_pca), 4)
        ],
        'AUC-ROC (OVR)': [
            round(auc_base, 4),
            round(auc_final, 4),
            round(auc_pca, 4),
            round(auc_opt_pca, 4)
        ],
    })

    display(df_genel4.style
            .highlight_max(subset=['Dürüst CV F1 (Macro)', 'Test F1 (Macro)', 'AUC-ROC (OVR)'], color=CUSTOM_PALETTE[2])
            .highlight_min(subset=['Sapma (Overfitting)'], color=CUSTOM_PALETTE[2])
            .set_properties(**{'border': f'1px solid {CUSTOM_PALETTE[0]}', 'text-align': 'center'})
            .set_caption('Büyük Final Karşılaştırması (PCA Üzerinde HPO ile)')
            .set_table_styles([{'selector': 'th', 'props': [('background-color', CUSTOM_PALETTE[0]), ('color', 'white')]}]))

except FileNotFoundError:
    print("❌ Hata: Dosya belirtilen yolda bulunamadı. Lütfen yolu kontrol edin.")
except Exception as e:
    print(f"❌ Bir hata oluştu: {e}")
