import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import train_test_split, cross_val_score
from imblearn.over_sampling import SMOTE
from imblearn.pipeline import Pipeline as ImbPipeline # 🟢 Sızdırmaz CV garantisi
from sklearn.svm import SVC # 🟢 Gradient Boosting yerine SVM
from sklearn.ensemble import GradientBoostingClassifier # Sadece özellik oylaması için
from sklearn.feature_selection import SelectKBest, f_classif, RFE
from sklearn.decomposition import PCA
from sklearn.metrics import (accuracy_score, f1_score, precision_score,
                             recall_score, roc_auc_score)
from google.colab import drive

# --- 1. ORTAM HAZIRLIĞI VE VERİ YÜKLEME ---
drive.mount('/content/drive')
path = '/content/drive/MyDrive/fra_cleaned.csv'

CUSTOM_PALETTE = ['#462506', '#9F6920', '#DAA755', '#E9C579', '#F1DEA8']
SEED = 42

try:
    data_raw = pd.read_csv(path, sep=';', encoding='latin-1')
    print("✅ 1. ADIM: Veri başarıyla yüklendi!")

    # --- 2. VERİ SETİNİ İLK 10 MARKA İLE SINIRLANDIRMA ---
    brand_counts = data_raw['Brand'].value_counts()
    top_10_list = brand_counts.head(10).index.tolist()
    data_filtered = data_raw[data_raw['Brand'].isin(top_10_list)].copy()

    # --- 3. ÖN İŞLEME: SAYISAL DÖNÜŞÜMLER ---
    if data_filtered['Rating Value'].dtype == 'object':
        data_filtered['Rating Value'] = data_filtered['Rating Value'].str.replace(',', '.').astype(float)

    # --- 4. KOPYALAMA VE EKSİK DEĞERLERİN DOLDURULMASI ---
    df = data_filtered.copy()
    for col in df.select_dtypes('object').columns:
        if not df[col].mode().empty: df[col] = df[col].fillna(df[col].mode()[0])
    for col in df.select_dtypes(include=[np.number]).columns:
        df[col] = df[col].fillna(df[col].median())

    # --- 5. HEDEF DEĞİŞKENİNİ ENCODE ETME ---
    le_brand = LabelEncoder()
    df['Brand_Encoded'] = le_brand.fit_transform(df['Brand'])

    # --- 6. GÜVENLİ KATEGORİK ENCODING ---
    exclude_cols = ['Brand', 'Brand_Encoded', 'url', 'Perfume', 'Description']
    feature_cols = [c for c in df.columns if c not in exclude_cols]

    for col in feature_cols:
        if df[col].dtype == 'object':
            le_temp = LabelEncoder()
            df[col] = le_temp.fit_transform(df[col].astype(str))

    X = df[feature_cols]
    y = df['Brand_Encoded']

    # --- 7. TRAIN / TEST AYRIMI ---
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=SEED, stratify=y
    )

    # --- 8. GEÇİCİ ÖLÇEKLEME VE SMOTE (Özellik Oylaması ve PCA Varyans Hesabı İçin) ---
    print('\n🚀 ÖN İŞLEME TAMAM. Özellik Oylaması için Geçici (Temp) Hesaplamalar yapılıyor...')
    # DİKKAT: Bu veriler CV veya Test'e ASLA GİRMEYECEK. Sadece "Hangi sütunlar önemli" oylaması içindir.
    scaler_temp = StandardScaler()
    X_train_sc_temp = scaler_temp.fit_transform(X_train)

    smote_temp = SMOTE(random_state=SEED)
    X_train_sm_temp, y_train_sm_temp = smote_temp.fit_resample(X_train_sc_temp, y_train)

    # =========================================================================
    # A. ÖZELLİK SEÇİMİ (VOTING/OYLAMA)
    # =========================================================================
    print('\n🚀 YÖNTEM A: ÖZELLİK SEÇİMİ (VOTING) HAZIRLANIYOR...')
    selector_kb = SelectKBest(score_func=f_classif, k=10).fit(X_train_sm_temp, y_train_sm_temp)
    selected_kb = np.array(feature_cols)[selector_kb.get_support()].tolist()

    # Ağaç Tabanlı Özellik Çıkarımı (SVM rbf ağırlık vermediği için Gradient Boosting kullanılır)
    gb_feat = GradientBoostingClassifier(n_estimators=50, random_state=SEED).fit(X_train_sm_temp, y_train_sm_temp)
    selected_gb = pd.DataFrame({'Özellik': feature_cols, 'Önem': gb_feat.feature_importances_}).sort_values('Önem', ascending=False).head(10)['Özellik'].tolist()

    rfe = RFE(estimator=gb_feat, n_features_to_select=10, step=1).fit(X_train_sm_temp, y_train_sm_temp)
    selected_rfe = np.array(feature_cols)[rfe.support_].tolist()

    sets = {'SelectKBest': set(selected_kb), 'GB Önemi': set(selected_gb), 'RFE': set(selected_rfe)}
    comparison = pd.DataFrame({name: [('✅' if f in s else '❌') for f in feature_cols] for name, s in sets.items()}, index=feature_cols)
    comparison['Oy Sayısı'] = comparison.apply(lambda r: list(r.values).count('✅'), axis=1)

    selected_final = comparison[comparison['Oy Sayısı'] >= 2].index.tolist()
    final_idx = [feature_cols.index(f) for f in selected_final]

    # Model eğitimi için Orijinal (Ham) veriden kesilmiş setler
    X_train_final_raw = X_train.iloc[:, final_idx]
    X_test_final_raw  = X_test.iloc[:, final_idx]

    # =========================================================================
    # B. PCA (VARYANS KORUMA) HAZIRLIĞI
    # =========================================================================
    print('\n🚀 YÖNTEM B: PCA BİLEŞEN SAYISI BELİRLENİYOR...')
    pca_temp = PCA(random_state=SEED).fit(X_train_sm_temp)
    cumvar = np.cumsum(pca_temp.explained_variance_ratio_) * 100
    n90 = np.argmax(cumvar >= 90) + 1
    print(f'📌 %90 Varyans için gereken PCA Bileşeni: {n90}')

    # =========================================================================
    # C. MODELLERİN SIZDIRMAZ EĞİTİLMESİ VE DEĞERLENDİRİLMESİ (SVM) 🟢
    # =========================================================================
    print('\n🚀 MODELLER SIZDIRMAZ PİPELİNE İLE EĞİTİLİYOR (SVM)...')

    # --- MODEL 1: BASELINE (TÜM ÖZELLİKLER) ---
    pipeline_base = ImbPipeline([
        ('scaler', StandardScaler()),
        ('smote', SMOTE(random_state=SEED)),
        ('svc', SVC(kernel='rbf', probability=True, random_state=SEED))
    ])

    cv_base = cross_val_score(pipeline_base, X_train, y_train, cv=5, scoring='f1_macro', n_jobs=-1)

    # Test performansı için Pipeline direkt kullanılarak eğitilir
    pipeline_base.fit(X_train, y_train)
    y_pred_base = pipeline_base.predict(X_test)
    y_prob_base = pipeline_base.predict_proba(X_test)
    test_f1_base = f1_score(y_test, y_pred_base, average='macro')
    auc_base = roc_auc_score(y_test, y_prob_base, multi_class='ovr')

    # --- MODEL 2: SEÇİLEN ÖZELLİKLER (VOTING) ---
    pipeline_final = ImbPipeline([
        ('scaler', StandardScaler()),
        ('smote', SMOTE(random_state=SEED)),
        ('svc', SVC(kernel='rbf', probability=True, random_state=SEED))
    ])

    cv_final = cross_val_score(pipeline_final, X_train_final_raw, y_train, cv=5, scoring='f1_macro', n_jobs=-1)

    pipeline_final.fit(X_train_final_raw, y_train)
    y_pred_final = pipeline_final.predict(X_test_final_raw)
    y_prob_final = pipeline_final.predict_proba(X_test_final_raw)
    test_f1_final = f1_score(y_test, y_pred_final, average='macro')
    auc_final = roc_auc_score(y_test, y_prob_final, multi_class='ovr')

    # --- MODEL 3: PCA ---
    # 🟢 DİKKAT: PCA dönüşümü Pipeline içine alındı. Sızıntı engellendi.
    pipeline_pca = ImbPipeline([
        ('scaler', StandardScaler()),
        ('smote', SMOTE(random_state=SEED)),
        ('pca', PCA(n_components=n90, random_state=SEED)),
        ('svc', SVC(kernel='rbf', probability=True, random_state=SEED))
    ])

    cv_scores_pca = cross_val_score(pipeline_pca, X_train, y_train, cv=5, scoring='f1_macro', n_jobs=-1)

    # PCA: 5-Fold CV Tablosu
    df_cv_pca = pd.DataFrame({
        'Kat (Fold)': [f'Fold {i+1}' for i in range(5)],
        'CV F1-Macro Skoru': cv_scores_pca.round(4)
    })
    summary_pca = pd.DataFrame([{
        'Kat (Fold)': 'Ortalama ± Std',
        'CV F1-Macro Skoru': f'{cv_scores_pca.mean():.4f} ± {cv_scores_pca.std():.4f}'
    }])
    print('\n─── Sızdırmaz 5-Fold CV Sonuçları (PCA + SVM) ───')
    display(pd.concat([df_cv_pca, summary_pca], ignore_index=True).style
            .set_caption(f'Dürüst 5-Fold Çapraz Doğrulama — PCA ({n90} Bileşen)')
            .applymap(lambda v: f'font-weight: bold; background-color: {CUSTOM_PALETTE[4]}; color: {CUSTOM_PALETTE[0]};'
                      if isinstance(v, str) and '±' in v else ''))

    # PCA Test Seti
    pipeline_pca.fit(X_train, y_train)
    y_pred_pca = pipeline_pca.predict(X_test)
    y_prob_pca = pipeline_pca.predict_proba(X_test)

    test_metrics_pca = {
        'Accuracy (Doğruluk)'  : accuracy_score(y_test, y_pred_pca),
        'F1-Score (Macro)'     : f1_score(y_test, y_pred_pca, average='macro'),
        'Precision (Kesinlik)' : precision_score(y_test, y_pred_pca, average='macro', zero_division=0),
        'Recall (Duyarlılık)'  : recall_score(y_test, y_pred_pca, average='macro'),
        'AUC-ROC (Macro OVR)'  : roc_auc_score(y_test, y_prob_pca, multi_class='ovr')
    }
    auc_pca = test_metrics_pca['AUC-ROC (Macro OVR)']

    df_test_pca = pd.DataFrame([{'Metrik': k, 'Değer': round(v, 4)} for k, v in test_metrics_pca.items()])
    print('\n─── Test Seti Sonuçları (PCA + SVM) ───')
    display(df_test_pca.style
            .set_properties(**{'background-color': CUSTOM_PALETTE[3], 'color': CUSTOM_PALETTE[0], 'font-weight': 'bold'})
            .set_caption(f'Test Seti Performans Metrikleri — PCA SVM'))

    # PCA: Overfitting (CV vs Test) Kontrol Tablosu
    df_compare_pca = pd.DataFrame({
        'Metrik'          : ['F1-Score (Macro)'],
        'Dürüst CV Skoru' : [round(cv_scores_pca.mean(), 4)],
        'Test Skoru'      : [round(test_metrics_pca['F1-Score (Macro)'], 4)],
        'Fark (Sapma)'    : [round(abs(cv_scores_pca.mean() - test_metrics_pca['F1-Score (Macro)']), 4)]
    })

    print('\n─── CV Skoru vs Test Skoru Karşılaştırması (PCA + SVM) ───')
    def style_compare(val, is_score=True):
        if is_score: return f'background-color: {CUSTOM_PALETTE[2]}; color: {CUSTOM_PALETTE[0]}; font-weight:bold;'
        else: return f'background-color: {CUSTOM_PALETTE[1]}; color: #fff; font-weight:bold;'

    display(df_compare_pca.style
            .applymap(lambda v: style_compare(v, True), subset=['Dürüst CV Skoru', 'Test Skoru'])
            .applymap(lambda v: style_compare(v, False), subset=['Fark (Sapma)'])
            .set_caption('PCA SVM: Dürüst CV ve Test Metrikleri — Overfitting Kontrolü'))

    # =========================================================================
    # D. ÜÇ YÖNTEM GENEL KARŞILAŞTIRMA (BÜYÜK FİNAL)
    # =========================================================================
    print('\n─── 🏆 Ham Veri / Seçilen Özellikler / PCA Genel Karşılaştırma Tablosu ───')

    df_genel3 = pd.DataFrame({
        'Veri Temsili': [
            f'1. Ham Veri ({X_train.shape[1]} Özellik)',
            f'2. Oylama ile Seçilen ({len(selected_final)} Özellik)',
            f'3. PCA ile Çıkarılan ({n90} Bileşen)'
        ],
        'Sütun Boyutu'   : [X_train.shape[1], len(selected_final), n90],
        'Dürüst CV F1'   : [round(cv_base.mean(), 4), round(cv_final.mean(), 4), round(cv_scores_pca.mean(), 4)],
        'Test F1 (Macro)': [round(test_f1_base, 4), round(test_f1_final, 4), round(test_metrics_pca['F1-Score (Macro)'], 4)],
        'Overfitting Sapması': [
            round(abs(cv_base.mean() - test_f1_base), 4),
            round(abs(cv_final.mean() - test_f1_final), 4),
            round(abs(cv_scores_pca.mean() - test_metrics_pca['F1-Score (Macro)']), 4)
        ],
        'AUC-ROC (OVR)'  : [round(auc_base, 4), round(auc_final, 4), round(auc_pca, 4)],
    })

    display(df_genel3.style
            .highlight_max(subset=['Dürüst CV F1', 'Test F1 (Macro)', 'AUC-ROC (OVR)'], color=CUSTOM_PALETTE[2])
            .highlight_min(subset=['Sütun Boyutu', 'Overfitting Sapması'], color=CUSTOM_PALETTE[2])
            .set_properties(**{'border': f'1px solid {CUSTOM_PALETTE[0]}', 'text-align': 'center'})
            .set_caption('Boyut Düşürme Stratejileri Sızdırmaz Karşılaştırma Matrisi (SVM)')
            .set_table_styles([{'selector': 'th', 'props': [('background-color', CUSTOM_PALETTE[0]), ('color', 'white')]}]))

except FileNotFoundError:
    print("❌ Hata: Dosya belirtilen yolda bulunamadı. Lütfen yolu kontrol edin.")
except Exception as e:
    print(f"❌ Bir hata oluştu: {e}")
